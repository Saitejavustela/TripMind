# TripMind AI - Environment Configuration for Real APIs
# Copy this file to .env.local and add your actual keys

# ==========================================
# Weather API (Phase 17: Weather-Aware Planning)
# ==========================================
# Get free API key from: https://openweathermap.org/api
NEXT_PUBLIC_USE_WEATHER_API=false  # Set to "true" to enable real weather API
OPENWEATHER_API_KEY=your_openweather_key_here  # Required if USE_WEATHER_API=true

# ==========================================
# Supabase (Phases 16-18: Collaboration, Expenses)
# ==========================================
# Get setup at: https://supabase.com
# 1. Create a Supabase project
# 2. Run the SQL migrations from supabase/migrations/
NEXT_PUBLIC_USE_SUPABASE=false  # Set to "true" to enable real APIs
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url  # Required if USE_SUPABASE=true
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key  # Required if USE_SUPABASE=true

# ==========================================
# AI Provider (Optional: for AI recommendations)
# ==========================================
# Get API key from: https://platform.anthropic.com or https://platform.openai.com
NEXT_PUBLIC_AI_PROVIDER=anthropic  # or "openai"
ANTHROPIC_API_KEY=your_anthropic_key_here  # Required for Claude AI
OPENAI_API_KEY=your_openai_key_here  # Required for GPT AI

# ==========================================
# Feature Toggles
# ==========================================
# Set to "true" to enable respective features
NEXT_PUBLIC_ENABLE_WEATHER_ALERTS=true
NEXT_PUBLIC_ENABLE_EXPENSE_TRACKING=true
NEXT_PUBLIC_ENABLE_COLLABORATIVE_PLANNING=true